    ],
    "PLATFORM": [
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      "next.config.js",
      "next.config.mjs",
      "next.config.ts",
      "next-env.d.ts",
      "tailwind.config.js",
      "tailwind.config.ts",
      "postcss.config.js",
      "postcss.config.mjs",
      "drizzle.config.ts",
      "vitest.config.ts",
      "components.json",
      "eslint.config.mjs",
      ".eslintrc.json",
      ".prettierrc",
      ".env.example",
      ".gitignore",
      ".githooks/",
      "scripts/dev/",
      ".github/",
      ".nvmrc",
      ".npmrc"
    ]
  },
  "shared": [
    "lib/contracts/",
    "_docs/",
    "README.md",
    "WORKING_LOG.md",
