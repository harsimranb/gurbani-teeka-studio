{
  "$comment": "Folder ownership by workstream. Read by scripts/dev/check-ownership.mjs (pre-commit). Paths are prefixes relative to the repo root; a path ending in / matches everything under it. Change only by agreement, in a commit of its own. See _docs/06-team-workflow.md.",
  "people": {
    "A": [
      "CHECKS",
      "LLM",
      "EVAL"
    ],
    "B": [
      "DATA",
      "API",
      "FE",
      "PLATFORM"
    ]
  },
  "streams": {
    "CHECKS": [
      "lib/engine/checks/",
      "lib/engine/gurmukhi/",
      "lib/engine/rules/",
      "lib/engine/index.ts"
    ],
    "LLM": [
      "lib/engine/llm/",
      "lib/engine/retrieval/",
      "lib/engine/drift/",
      "data/cache/",
      "scripts/engine/bakeoff.ts"
    ],
    "EVAL": [
      "lib/engine/eval/",
      "scripts/engine/eval.ts",
      "data/eval/"
    ],
    "DATA": [
      "lib/server/db/",
      "lib/server/ingest/",
      "scripts/app/",
      "data/banidb/",
      "data/sikhri-sample/"
    ],
    "API": [
      "app/api/",
      "lib/server/services/"
    ],
    "FE": [
